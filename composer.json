{
    "name": "amirkateb/payment-core-client",
    "description": "Secure Laravel client SDK for AvazTek Payment Platform",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Avaztek\\PaymentCore\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Avaztek\\PaymentCore\\PaymentCoreServiceProvider"
            ],
            "aliases": {
                "PaymentCore": "Avaztek\\PaymentCore\\Facades\\PaymentCore"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/amirkateb/payment-core-client"
    }
}
